# ─── Node.js / npm ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.npmrc.local
.eslintcache
*.tsbuildinfo

# ─── Логи ────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

# ─── Окружение и секреты ─────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
settings.json

# ─── Electron / сборка ───────────────────────────
dist/
out/
build/
release/
*.asar
.electron-builder-cache/
electron-builder-effective-config.yaml
app-update.yml
latest.yml

# ─── Плагины, установленные пользователем ────────
# Не коммитим то, что поставили через drag&drop.
# Но папку plugins/ и встроенный clicker оставляем.
plugins/_install_*/
plugins/*/
!plugins/clicker/
!plugins/.gitkeep
plugins/**/node_modules/

# ─── Временные файлы во время разработки ─────────
.tmp/
.temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ─── Кэш туннелей (cloudflared, ngrok) ───────────
.cache/
.cloudflared/
.ngrok/
*.trycloudflare.com
cloudflared.exe
cloudflared
ngrok.exe
ngrok
node_modules/.cache/untun/

# ─── Локальные настройки приложения ──────────────
# app.getPath('userData') пишет в %APPDATA%, но если
# разработчик случайно положит settings.json рядом — не коммитить
userData/
user-data/

# ─── ОС ──────────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
Icon?
*.icloud

# Linux
.directory
.Trash-*
.nfs*

# ─── IDE / редакторы ─────────────────────────────
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example

# JetBrains (WebStorm, IDEA)
.idea/
*.iml
*.ipr
*.iws

# Sublime
*.sublime-workspace
*.sublime-project

# Vim
*.vim
.*.sw?

